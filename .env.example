# ---- Generative LLMs: set at least one (all have free tiers) ----
# Google AI Studio (Gemini free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier, very fast): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (":free" models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Local Ollama (fully offline, $0): e.g. http://localhost:11434/v1
OLLAMA_BASE_URL=

# Model overrides (free-tier model names change; adjust if a provider renames them)
# GEMINI_SYNTH_MODEL=gemini-3.5-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_SYNTH_MODEL=openai/gpt-oss-120b
# FAST_PROVIDER_ORDER=groq,gemini,openrouter,ollama
# SYNTH_PROVIDER_ORDER=gemini,groq,openrouter,ollama
# GROQ_VERIFY_MODEL=openai/gpt-oss-20b # claim checks off the synthesis model = its own per-minute token bucket
# VERIFY_PROVIDER_ORDER=groq,gemini,openrouter,ollama

# ---- Laya: local, open-source System 1 decision model (relevance + first-pass verification) ----
# Runs in-process for $0; weights (~850 MB) download from Hugging Face on first start.
# LAYA_ENABLED=true
# LAYA_SUBFOLDER=              # "" = English checkpoint; "multilingual" for non-English research
# LAYA_DEVICE=                 # "" = auto (CUDA -> Apple MPS -> CPU); "cpu" to force
# HF_HUB_OFFLINE=1             # set once the weights are cached to skip network checks

# ---- Search (DuckDuckGo works with no key) ----
# SEARXNG_URL=http://localhost:8888      # self-hosted SearXNG with JSON format enabled
# DDG_BACKENDS=yahoo,bing                 # raced in parallel per query; "auto" is the fallback
# TAVILY_API_KEY=                         # free 1k credits/month
# BRAVE_API_KEY=
# SEARCH_PROVIDER_ORDER=searxng,ddg,tavily,brave
# USE_JINA_READER=true                    # keyless fallback reader for JS-heavy pages

# ---- Guardrails ----
# COST_BUDGET_USD=0.05
# MAX_RUN_SECONDS=150

# ---- Public deployment ----
# ACCESS_TOKEN=choose-a-long-random-string   # required to start research / view history
# RUNS_PER_HOUR_PER_IP=12
# PUBLIC_BASE_URL=https://your-app.example.com
# DB_PATH=/data/research.db
